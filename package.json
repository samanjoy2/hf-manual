{
  "name": "hf-access-desk",
  "version": "1.3.1",
  "private": true,
  "description": "A secure Electron desktop app for managing gated Hugging Face dataset access requests.",
  "main": "electron/main.cjs",
  "author": "samanjoy2",
  "homepage": "https://github.com/samanjoy2/hf-manual",
  "repository": {
    "type": "git",
    "url": "https://github.com/samanjoy2/hf-manual.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "check": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check electron/updates.cjs && node --check electron/request-monitor.cjs && node --check public/theme.js && node --check public/app.js && node --check public/demo.js && node scripts/check_external_links.cjs && node --test scripts/check_background_features.cjs",
    "build:icon": "python scripts/generate_icon.py",
    "screenshots": "node scripts/capture_screenshots.cjs",
    "check:ui": "node scripts/check_interface.cjs",
    "dist:win": "npm run build:icon && electron-builder --win nsis --x64"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.samanjoy.hfaccessdesk",
    "productName": "HF Access Desk",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/app-icon-v2.ico",
      "artifactName": "HF-Access-Desk-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HF Access Desk",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
