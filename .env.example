# A Hugging Face user access token with write access to every dataset you manage.
HF_TOKEN=hf_replace_me

# Strongly recommended outside localhost. This protects the dashboard itself.
APP_PASSWORD=replace-with-a-long-random-password

# Optional: comma-separated dataset IDs that auto-discovery does not find.
# HF_DATASETS=my-name/private-dataset,my-org/another-dataset

# Optional server settings.
PORT=7860
HOST=127.0.0.1
# HF_ENDPOINT=https://huggingface.co
